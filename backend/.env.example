# Optional fallback. Values in backend/config.json take priority.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_TEMPERATURE=0.2
# DEEPSEEK_CONFIG_FILE=./config.json

# Local paths and limits
SOURCE_DIR=../MySource
MODEL_UPLOAD_DIR=./storage/models
MODEL_CACHE_DIR=./storage/cache
KNOWLEDGE_DIR=./documents
MAX_UPLOAD_MB=100
MAX_CONTEXT_CHARS=18000

# Comma-separated origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
